{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/((?!_next|banners|products|.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|js|css)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, force-revalidate"
        }
      ]
    }
  ]
}
